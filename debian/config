#!/bin/sh

# Optional node number from apt/dpkg environment (NODE_NUMBER=12345 apt install ...).
NODE_NUMBER="${NODE_NUMBER-}"

# shellcheck disable=SC1091
. /usr/share/debconf/confmodule

is_valid_node_number() {
    echo "$1" | grep -qE '^[0-9]{1,10}$'
}

# Strip a trailing Asterisk ; comment (and whitespace) from a config line.
strip_asl_comment() {
    echo "$1" | sed 's/[[:space:]]*;.*//'
}

# True if inheritance list contains the exact token functions-sayip.
has_active_functions_sayip() {
    line="$(strip_asl_comment "$1")"
    echo "$line" | grep -qE '\(([^)]*,)?functions-sayip([,)]|$)'
}

node=""

if is_valid_node_number "$NODE_NUMBER"; then
    node="$NODE_NUMBER"
elif [ -f /etc/asterisk/custom/rpt/sayip.conf ]; then
    # Use sed -E so '+' matches grep -E; plain sed BRE treats bare '+' as literal
    # and falsely reports an existing sayip.conf as unrecognized.
    node="$(grep -E 'sayip-node-utils[[:space:]]+[lphr][[:space:]]+' /etc/asterisk/custom/rpt/sayip.conf 2>/dev/null \
        | head -1 \
        | sed -nE 's/.*sayip-node-utils[[:space:]]+[lphr][[:space:]]+([0-9][0-9]*).*/\1/p')"
fi

if ! is_valid_node_number "$node" && [ -f /etc/asterisk/rpt.conf ]; then
    while IFS= read -r line; do
        case "$line" in
            \[functions-[0-9]*)
                if has_active_functions_sayip "$line"; then
                    node="$(echo "$line" | sed -n 's/^\[functions-\([0-9][0-9]*\)\].*/\1/p')"
                    break
                fi
                ;;
        esac
    done < /etc/asterisk/rpt.conf

    if ! is_valid_node_number "$node"; then
        node="$(grep -E '^\[[0-9]+\]\(node-main' /etc/asterisk/rpt.conf 2>/dev/null \
            | head -1 \
            | sed -n 's/^\[\([0-9][0-9]*\)\].*/\1/p')"
    fi
fi

if ! is_valid_node_number "$node" && [ -f /etc/internet-monitor.conf ]; then
    node="$(grep -E '^NODE_NUMBER=' /etc/internet-monitor.conf 2>/dev/null \
        | head -1 | cut -d= -f2- | tr -d '[:space:]')"
fi

if is_valid_node_number "$node"; then
    db_set sayip-node-utils/node-number "$node"
else
    db_get sayip-node-utils/node-number || RET=""
    if ! is_valid_node_number "$RET"; then
        db_input medium sayip-node-utils/node-number || true
    fi
fi

db_go || true
