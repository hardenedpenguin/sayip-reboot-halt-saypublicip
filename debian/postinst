#!/bin/sh
set -e

# Postinst script - run after package installation
# Optional node number from apt/dpkg environment (NODE_NUMBER=12345 apt install ...).
NODE_NUMBER="${NODE_NUMBER-}"

# Sourcing confmodule re-execs this script under the debconf frontend, so it
# must happen at top level where "$@" still holds the script's arguments.
# Sourcing it inside a function would re-exec with the function's arguments,
# silently skipping the "configure" branch below.
if [ -f /usr/share/debconf/confmodule ]; then
    # shellcheck disable=SC1091
    . /usr/share/debconf/confmodule
fi

PENDING_UNWIRE="/var/lib/sayip-node-utils/pending-unwire"

is_valid_node_number() {
    echo "$1" | grep -qE '^[0-9]{1,10}$'
}

# Strip a trailing Asterisk ; comment (and whitespace) from a config line.
strip_asl_comment() {
    echo "$1" | sed 's/[[:space:]]*;.*//'
}

# True if inheritance list contains the exact token functions-sayip.
has_active_functions_sayip() {
    line="$(strip_asl_comment "$1")"
    echo "$line" | grep -qE '\(([^)]*,)?functions-sayip([,)]|$)'
}

extract_node_from_sayip_conf() {
    conf="/etc/asterisk/custom/rpt/sayip.conf"
    node=""

    [ -f "$conf" ] || return 1

    node="$(grep -E 'sayip-node-utils[[:space:]]+[lphr][[:space:]]+' "$conf" 2>/dev/null | head -1 \
        | sed -n 's/.*sayip-node-utils[[:space:]]+[lphr][[:space:]]\+\([0-9][0-9]*\).*/\1/p')"

    if is_valid_node_number "$node"; then
        echo "$node"
        return 0
    fi

    return 1
}

# Prefer a functions-NODE stanza that already inherits functions-sayip, else the
# first ASL3 [NODE](node-main...) stanza in rpt.conf.
extract_node_from_rpt_conf() {
    rpt="/etc/asterisk/rpt.conf"
    node=""

    [ -f "$rpt" ] || return 1

    while IFS= read -r line; do
        case "$line" in
            \[functions-[0-9]*)
                if has_active_functions_sayip "$line"; then
                    node="$(echo "$line" | sed -n 's/^\[functions-\([0-9][0-9]*\)\].*/\1/p')"
                    break
                fi
                ;;
        esac
    done < "$rpt"

    if ! is_valid_node_number "$node"; then
        node="$(grep -E '^\[[0-9]+\]\(node-main' "$rpt" 2>/dev/null \
            | head -1 \
            | sed -n 's/^\[\([0-9][0-9]*\)\].*/\1/p')"
    fi

    if is_valid_node_number "$node"; then
        echo "$node"
        return 0
    fi

    return 1
}

extract_node_from_internet_monitor() {
    conf="/etc/internet-monitor.conf"
    node=""

    [ -f "$conf" ] || return 1

    node="$(grep -E '^NODE_NUMBER=' "$conf" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '[:space:]')"

    if is_valid_node_number "$node"; then
        echo "$node"
        return 0
    fi

    return 1
}

remember_node_number() {
    node_number="$1"

    [ -n "$node_number" ] || return 0
    command -v db_set >/dev/null 2>&1 || return 0

    db_set sayip-node-utils/node-number "$node_number" || true
}

get_node_number() {
    node=""

    if is_valid_node_number "$NODE_NUMBER"; then
        echo "$NODE_NUMBER"
        return 0
    fi

    if command -v db_get >/dev/null 2>&1; then
        if db_get sayip-node-utils/node-number && is_valid_node_number "$RET"; then
            echo "$RET"
            return 0
        fi
    fi

    if node="$(extract_node_from_sayip_conf 2>/dev/null)" && is_valid_node_number "$node"; then
        echo "$node"
        return 0
    fi

    if node="$(extract_node_from_rpt_conf 2>/dev/null)" && is_valid_node_number "$node"; then
        echo "$node"
        return 0
    fi

    if node="$(extract_node_from_internet_monitor 2>/dev/null)" && is_valid_node_number "$node"; then
        echo "$node"
        return 0
    fi

    if [ -t 0 ] && [ -t 1 ]; then
        echo "" >&2
        echo "AllStarLink Node Number Configuration" >&2
        echo "======================================" >&2
        while ! is_valid_node_number "$node"; do
            printf "Please enter your AllStarLink node number (1-10 digits): " >&2
            read -r node || node=""
            if [ -n "$node" ] && ! is_valid_node_number "$node"; then
                echo "Invalid node number: $node" >&2
                node=""
            fi
        done
        echo "$node"
        return 0
    fi

    return 1
}

sayip_conf_node() {
    extract_node_from_sayip_conf 2>/dev/null || true
}

remember_pending_unwire() {
    old_node="$1"
    [ -n "$old_node" ] || return 0
    mkdir -p "$(dirname "$PENDING_UNWIRE")"
    echo "$old_node" > "$PENDING_UNWIRE"
}

clear_pending_unwire() {
    rm -f "$PENDING_UNWIRE"
}

# Exit codes:
#   0 - wrote sayip.conf (stdout may contain previous node)
#   1 - skipped; existing file already matches node_number (safe to wire)
#   2 - skipped; existing file unrecognized/incompatible (do not wire)
install_sayip_conf() {
    node_number="$1"
    force="${2:-}"
    example="/usr/share/doc/sayip-node-utils/sayip.conf.example"
    target="/etc/asterisk/custom/rpt/sayip.conf"
    previous=""
    tmp=""

    mkdir -p /etc/asterisk/custom/rpt

    if [ -f "$target" ] && [ "$force" != "force" ]; then
        existing="$(sayip_conf_node)"
        if [ -n "$node_number" ] && [ "$existing" = "$node_number" ]; then
            echo "Configuration file $target already matches node $node_number; leaving unchanged." >&2
            return 1
        fi
        if [ -z "$node_number" ]; then
            echo "Configuration file $target already exists; leaving unchanged." >&2
            return 2
        fi
        # Unrecognized node: rewrite only if this is still the unconfigured
        # $NODE placeholder from a prior install without a node number.
        if [ -z "$existing" ]; then
            # Intentional literal $NODE placeholder match (not a shell variable).
            # shellcheck disable=SC2016
            if grep -qE 'sayip-node-utils[[:space:]]+[lphr][[:space:]]+\$NODE' "$target" 2>/dev/null; then
                echo "Replacing unconfigured placeholder in $target with node $node_number." >&2
            else
                echo "Configuration file $target exists but node number is unrecognized; leaving unchanged." >&2
                return 2
            fi
        fi
        if [ -n "$existing" ] && [ "$existing" != "$node_number" ]; then
            echo "Updating $target for node change ($existing -> $node_number)." >&2
            previous="$existing"
        fi
    fi

    tmp="$(mktemp "${target}.XXXXXX")"

    if [ -n "$node_number" ]; then
        sed "s/\$NODE/$node_number/g" "$example" > "$tmp" || {
            rm -f "$tmp"
            return 2
        }
    else
        cp "$example" "$tmp" || {
            rm -f "$tmp"
            return 2
        }
    fi

    chmod 0644 "$tmp" || {
        rm -f "$tmp"
        return 2
    }
    chown asterisk:asterisk "$tmp" 2>/dev/null || true
    mv "$tmp" "$target" || {
        rm -f "$tmp"
        return 2
    }

    if [ -n "$previous" ]; then
        echo "$previous"
    fi
    return 0
}

unwire_rpt_for_sayip() {
    old_node="$1"
    helper="/usr/lib/sayip-node-utils/configure-rpt-sayip.sh"

    [ -n "$old_node" ] || return 0
    [ -x "$helper" ] || return 1

    if "$helper" --unwire "$old_node"; then
        return 0
    fi

    echo "Warning: Failed to remove SayIP mapping for previous node $old_node"
    return 1
}

configure_rpt_for_sayip() {
    node_number="$1"
    helper="/usr/lib/sayip-node-utils/configure-rpt-sayip.sh"

    [ -n "$node_number" ] || return 0
    [ -x "$helper" ] || return 0

    "$helper" "$node_number" || {
        echo "Warning: Failed to update /etc/asterisk/rpt.conf for node $node_number"
        return 0
    }
}

retry_pending_unwire() {
    [ -f "$PENDING_UNWIRE" ] || return 0

    old_node="$(tr -d '[:space:]' < "$PENDING_UNWIRE")"
    if ! is_valid_node_number "$old_node"; then
        clear_pending_unwire
        return 0
    fi

    echo "Retrying pending SayIP unwire for previous node $old_node..."
    if unwire_rpt_for_sayip "$old_node"; then
        clear_pending_unwire
    else
        echo "Warning: Pending unwire for node $old_node remains at $PENDING_UNWIRE"
    fi
}

install_systemd_service() {
    node_number="$1"
    example="/usr/share/doc/sayip-node-utils/examples/allstar-sayip.service"
    target="/etc/systemd/system/allstar-sayip.service"

    [ -n "$node_number" ] || return 0
    [ -f "$example" ] || return 0

    sed "s/NODE_NUMBER_PLACEHOLDER/$node_number/g" "$example" > "$target"
    chmod 0644 "$target"
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable allstar-sayip.service 2>/dev/null || true
}

if [ "$1" = "configure" ]; then
    node_number=""
    if node_number="$(get_node_number)"; then
        remember_node_number "$node_number"
    else
        echo "No node number configured."
        echo "Use NODE_NUMBER=12345 apt install/reinstall sayip-node-utils or answer debconf."
    fi

    retry_pending_unwire

    if [ ! -f /etc/default/sayip ] && [ -f /usr/share/doc/sayip-node-utils/sayip.example ]; then
        cp /usr/share/doc/sayip-node-utils/sayip.example /etc/default/sayip
        chmod 0644 /etc/default/sayip
        echo "Default configuration installed at /etc/default/sayip"
    fi

    if [ -f /etc/sudoers.d/sayip-node-utils ]; then
        chmod 0440 /etc/sudoers.d/sayip-node-utils
        if command -v visudo >/dev/null 2>&1; then
            visudo -cf /etc/sudoers.d/sayip-node-utils >/dev/null 2>&1 || {
                echo "Warning: sudoers entry failed validation; halt/reboot may require root"
            }
        fi
    fi

    if [ -n "$node_number" ]; then
        previous_node=""
        conf_status=0
        if [ ! -f /etc/asterisk/custom/rpt/sayip.conf ]; then
            install_sayip_conf "$node_number" force >/dev/null || conf_status=$?
            if [ "$conf_status" -eq 0 ]; then
                echo "Configuration file created at /etc/asterisk/custom/rpt/sayip.conf"
            fi
        else
            # Status messages go to stderr; previous node (if any) is on stdout.
            # Exit 1 = already matches; exit 2 = unrecognized (do not wire).
            conf_status=0
            previous_node="$(install_sayip_conf "$node_number")" || conf_status=$?
        fi

        if [ "$conf_status" -eq 2 ]; then
            echo "Skipping rpt.conf wiring; $node_number does not match preserved sayip.conf commands."
        else
            if [ -n "$previous_node" ] && [ "$previous_node" != "$node_number" ]; then
                if ! unwire_rpt_for_sayip "$previous_node"; then
                    remember_pending_unwire "$previous_node"
                else
                    clear_pending_unwire
                fi
            fi
            configure_rpt_for_sayip "$node_number"
        fi
    elif [ ! -f /etc/asterisk/custom/rpt/sayip.conf ]; then
        install_sayip_conf "" force >/dev/null || true
        echo "Configuration file created at /etc/asterisk/custom/rpt/sayip.conf (set node number and reinstall)"
    else
        echo "Leaving existing /etc/asterisk/custom/rpt/sayip.conf unchanged (no node number available)."
    fi

    chown asterisk:asterisk /usr/sbin/sayip-node-utils 2>/dev/null || true
    chown -R asterisk:asterisk /usr/local/share/asterisk/sounds 2>/dev/null || true

    if [ -n "$node_number" ]; then
        install_systemd_service "$node_number"
        echo "Systemd service allstar-sayip.service installed and enabled"
    elif [ ! -f /etc/systemd/system/allstar-sayip.service ]; then
        echo "Boot-time IP announcement service was not created without a node number."
        echo "Reinstall with NODE_NUMBER=12345 or configure debconf to enable it."
    fi
fi

exit 0
